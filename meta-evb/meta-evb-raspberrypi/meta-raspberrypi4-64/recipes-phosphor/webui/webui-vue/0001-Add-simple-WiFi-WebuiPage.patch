diff --git a/src/views/Settings/WiFi/WiFi.vue b/src/views/Settings/WiFi/WiFi.vue
new file mode 100644
index 0000000..5c11f2e
--- /dev/null
+++ b/src/views/Settings/WiFi/WiFi.vue
@@ -0,0 +1,268 @@
+<template>
+  <b-container fluid="xl">
+    <page-title title="Wi-Fi Settings" />
+
+    <b-card class="mb-4">
+      <div class="d-flex justify-content-between align-items-center">
+        <div>
+          <h5 class="mb-1">Wi-Fi</h5>
+          <small class="text-muted">
+            When enabled, nearby wireless access points can be scanned by pressing below Rescan button
+          </small>
+        </div>
+        <b-form-checkbox
+          :model-value="wifiEnabled"
+          :disabled="loading"
+          switch
+          size="lg"
+          @update:model-value="toggleWiFi"
+        >
+          {{ loading ? 'Loading...' : wifiEnabled ? 'Enabled' : 'Disabled' }}
+        </b-form-checkbox>
+      </div>
+    </b-card>
+
+    <div v-if="wifiEnabled">
+      <div class="d-flex justify-content-between align-items-center mb-3">
+        <h5 class="mb-0">Available networks</h5>
+        <b-button variant="outline-primary" size="sm" @click="scanNetworks">
+          Rescan
+        </b-button>
+      </div>
+
+      <b-list-group>
+        <b-list-group-item
+          v-for="net in networks"
+          :key="net.SSID"
+          button
+          class="d-flex justify-content-between align-items-center"
+          @click="handleNetworkClick(net)"
+        >
+          <div>
+            <strong>{{ net.SSID }}</strong>
+            <b-badge v-if="net.Connected" variant="success" class="ms-2">
+              Connected (click to disconnect)
+            </b-badge>
+          </div>
+          <div class="d-flex align-items-center text-muted">
+            <span
+              class="signal-bars me-2"
+              :class="`signal-${signalLevel(net.Signal).color}`"
+              :title="formatSignalBars(net.Signal)"
+              role="img"
+              :aria-label="`Signal ${formatSignalBars(net.Signal)}`"
+            >
+              <span
+                v-for="n in 3"
+                :key="n"
+                class="signal-bar"
+                :class="{ active: n <= signalLevel(net.Signal).bars }"
+                :style="{ height: `${n * 5 + 3}px` }"
+              />
+            </span>
+            <span>{{ net.Signal }} dBm</span>
+          </div>
+        </b-list-group-item>
+      </b-list-group>
+    </div>
+
+    <b-modal
+      v-model="showConnectModal"
+      :title="`Connect to ${selectedNetwork ? selectedNetwork.SSID : ''}`"
+      ok-title="Connect"
+      cancel-title="Cancel"
+      :ok-disabled="password.length < 8"
+      @ok="connectToNetwork"
+    >
+      <b-form-group
+        label="Wi-Fi password"
+        description="<br />WPA/WPA2 password, at least 8 characters"
+      >
+        <b-form-input
+          v-model="password"
+          type="password"
+          placeholder="Enter password"
+          autocomplete="off"
+        />
+      </b-form-group>
+    </b-modal>
+
+    <b-modal
+      v-model="showDisconnectModal"
+      title="Disconnect Wi-Fi"
+      ok-title="Disconnect"
+      ok-variant="danger"
+      cancel-title="Cancel"
+      @ok="disconnectNetwork"
+    >
+      <p class="mb-0">
+        Are you sure you want to disconnect from
+        <strong>{{ selectedNetwork ? selectedNetwork.SSID : '' }}</strong>?
+      </p>
+    </b-modal>
+  </b-container>
+</template>
+
+<script>
+import api from '@/store/api';
+import BVToastMixin from '@/components/Mixins/BVToastMixin';
+import PageTitle from '@/components/Global/PageTitle';
+
+const WIFI_BASE = '/redfish/v1/Managers/bmc/EthernetInterfaces/wlan0';
+
+export default {
+  name: 'WiFiSettings',
+  components: { PageTitle },
+  mixins: [BVToastMixin],
+  data() {
+    return {
+      loading: true,
+      wifiEnabled: false,
+      networks: [],
+      selectedNetwork: null,
+      password: '',
+      showConnectModal: false,
+      showDisconnectModal: false,
+    };
+  },
+  created() {
+    this.fetchWiFiStatus();
+  },
+  methods: {
+    uniqueNetworks(list) {
+      const bySsid = new Map();
+      list.forEach((net) => {
+        const current = bySsid.get(net.SSID);
+        if (
+          !current ||
+          (net.Connected && !current.Connected) ||
+          (net.Connected === current.Connected && net.Signal > current.Signal)
+        ) {
+          bySsid.set(net.SSID, net);
+        }
+      });
+      return [...bySsid.values()].sort(
+        (a, b) =>
+          Number(b.Connected) - Number(a.Connected) || b.Signal - a.Signal,
+      );
+    },
+    async fetchWiFiStatus() {
+      try {
+        const { data } = await api.get(`${WIFI_BASE}/Oem/OpenBmc/WiFi`);
+        this.wifiEnabled = !!data.Enabled;
+        this.networks = this.uniqueNetworks(data.Networks || []);
+      } catch (error) {
+        this.errorToast('Failed to load Wi-Fi status.');
+      } finally {
+        this.loading = false;
+      }
+    },
+    async toggleWiFi(enabled) {
+      try {
+        // Disconnect first when disabling so the backend can release the link and IP
+        if (!enabled) {
+          const connected = this.networks.find((n) => n.Connected);
+          if (connected) {
+            await api.post(`${WIFI_BASE}/Actions/Oem/WiFi.Disconnect`);
+          }
+        }
+
+        await api.patch(`${WIFI_BASE}/Oem/OpenBmc/WiFi`, { Enabled: enabled });
+        this.wifiEnabled = enabled;
+        if (enabled) {
+          await this.scanNetworks();
+        } else {
+          this.networks = [];
+        }
+      } catch (error) {
+        this.errorToast('Failed to change Wi-Fi state.');
+        await this.fetchWiFiStatus();
+      }
+    },
+    async scanNetworks() {
+      try {
+        await api.post(`${WIFI_BASE}/Actions/Oem/WiFi.Scan`);
+        await new Promise((resolve) => setTimeout(resolve, 2000));
+        await this.fetchWiFiStatus();
+        await new Promise((resolve) => setTimeout(resolve, 3000));
+        await this.fetchWiFiStatus();
+      } catch (error) {
+        this.errorToast('Failed to start Wi-Fi scan.');
+      }
+    },
+    handleNetworkClick(network) {
+      this.selectedNetwork = network;
+      if (network.Connected) {
+        this.showDisconnectModal = true;
+      } else {
+        this.password = '';
+        this.showConnectModal = true;
+      }
+    },
+    async connectToNetwork() {
+      try {
+        await api.post(`${WIFI_BASE}/Actions/Oem/WiFi.Connect`, {
+          SSID: this.selectedNetwork.SSID,
+          Password: this.password,
+        });
+        this.successToast(`Connecting to ${this.selectedNetwork.SSID}.`);
+        await new Promise((resolve) => setTimeout(resolve, 3000));
+        await this.fetchWiFiStatus();
+        await new Promise((resolve) => setTimeout(resolve, 4000));
+        await this.fetchWiFiStatus();
+      } catch (error) {
+        this.errorToast('Failed to connect to the network.');
+      } finally {
+        this.password = '';
+      }
+    },
+    async disconnectNetwork() {
+      try {
+        await api.post(`${WIFI_BASE}/Actions/Oem/WiFi.Disconnect`);
+        this.successToast('Wi-Fi disconnected.');
+        setTimeout(() => this.fetchWiFiStatus(), 1500);
+      } catch (error) {
+        this.errorToast('Failed to disconnect.');
+      }
+    },
+    formatSignalBars(dbm) {
+      if (dbm >= -55) return 'Excellent';
+      if (dbm >= -70) return 'Good';
+      if (dbm >= -80) return 'Fair';
+      return 'Weak';
+    },
+    signalLevel(dbm) {
+      if (dbm >= -70) return { bars: 3, color: 'green' };
+      if (dbm >= -80) return { bars: 2, color: 'yellow' };
+      return { bars: 1, color: 'red' };
+    },
+  },
+};
+</script>
+
+<style lang="scss" scoped>
+.signal-bars {
+  display: inline-flex;
+  align-items: flex-end;
+  gap: 2px;
+  height: 18px;
+}
+
+.signal-bar {
+  width: 4px;
+  border-radius: 1px;
+  background-color: #d0d0d0;
+}
+
+.signal-green .signal-bar.active {
+  background-color: #28a745;
+}
+
+.signal-yellow .signal-bar.active {
+  background-color: #ffc107;
+}
+
+.signal-red .signal-bar.active {
+  background-color: #dc3545;
+}
+</style>
