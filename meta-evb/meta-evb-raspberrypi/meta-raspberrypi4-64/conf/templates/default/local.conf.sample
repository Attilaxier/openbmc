MACHINE ??= "raspberrypi"
DISTRO ?= "openbmc-phosphor"
PACKAGE_CLASSES ?= "package_ipk"
SANITY_TESTED_DISTROS:append ?= " *"
EXTRA_IMAGE_FEATURES ?= "allow-root-login"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"

# Set the root password to '0penBmc'
# Defaults from meta-phosphor/conf/distro/include/phosphor-defaults.inc

require conf/machine/include/obmc-bsp-common.inc
require conf/machine/include/obmc-evb-common.inc

# Change kernel type from zImage to Image 
KERNEL_IMAGETYPE = "Image"
KERNEL_IMAGETYPES = ""

# linux-firmware-rpidistro RPROVIDES linux-firmware-rpidistro-bcm43455
# but was skipped: Has a restricted license 'synaptics-killswitch' 
# which is not listed in your LICENSE_FLAGS_ACCEPTED.
LICENSE_FLAGS_ACCEPTED:append = " synaptics-killswitch"

# The postinstall intercept hook 'update_pixbuf_cache' failed
POSTINST_INTERCEPTS_DIR = "/tmp/empty_intercepts"

# Resign build image filesystems
IMAGE_FSTYPES:append = " wic wic.bz2 wic.bmap"
IMAGE_FSTYPES:remove = " mtd-static mtd-static-tar mtd-static-alltar mtd-ubi mtd-ubi-tar"

# Enable uart console
ENABLE_UART = "1"

# Deploy u-boot
RPI_USE_U_BOOT = "1"

# Enable module operation
PACKAGECONFIG:append:pn-systemd = " kmod"

# Add wlan features
IMAGE_INSTALL:append = " linux-firmware-rpidistro-bcm43455 kernel-module-brcmfmac"
IMAGE_INSTALL:append = " wireless-regdb-static wpa-supplicant iw"
KERNEL_MODULE_AUTOLOAD:append = " brcmfmac"

# Add WiFi settings redfish API and Webpage
ENABLE_WIFI_UI = 1

# Add zerotier service
IMAGE_INSTALL:append = " zerotier-one"
WARN_QA:remove = "license-format"
ERROR_QA:remove = "license-format"
LICENSE_PATH:append = "${LAYERDIR}/files/custom-licenses/"